{
  "name": "mail-desk",
  "version": "1.0.0",
  "description": "macOS Apple Mail workspace controlled with AppleScript",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "start:web": "node server.js",
    "build:icons": "swift scripts/build-icons.swift",
    "build:mac": "electron-builder --mac dir --arm64",
    "test": "node --test test/*.test.js",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "playwright": "1.63.0"
  }
}
